NEXT_PUBLIC_API_URL=https://api.myorbisvoice.com

# Silent SSO. NEXT_PUBLIC_* is inlined at BUILD time (deploy.sh runs the web build
# locally, then ships .next/), NOT read from the container env — so it has to live in
# the file the production build reads, or the flag is just `false` in the bundle.
# Setting it on the container does nothing; that is why it looked "set" and wasn't.
#
# It was missing, which made PRODUCTION run the local-dev fallback path:
#
#   access token expires (15m TTL) → getAccessToken() still returns it (it never
#   checks expiry) → isAuthenticated() true → AuthGuard passes → the page RENDERS →
#   its first API call 401s → tryRefresh() fails → redirectToLogin() → OIDC off, so
#   window.location.href = '/login' → the login page funnels any plain visit to the
#   hub → you land back on products.myorbisresults.com/dashboard.
#
# i.e. every Voice page opened and then threw you out, on any session older than 15
# minutes. With this true, redirectToLogin() rides the shared Keycloak session and
# returns you to the page you were on.
NEXT_PUBLIC_OIDC_ENABLED=true
